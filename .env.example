# Add your Groq API key from https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here

# Required 32+ character secret for signing zero-spoiler live simulation tokens
SESSION_SECRET=your_secure_random_session_secret_min_32_chars_here

# Secret for authenticating administrative telemetry access (GET /api/events)
ADMIN_SECRET=your_admin_secret_for_events_telemetry_here
